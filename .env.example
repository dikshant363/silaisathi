# SilaiSathi Environment Configuration Example
# Copy this file to .env.local or .env for local configuration.
# DO NOT COMMIT REAL API KEYS TO VERSION CONTROL.

# Optional Cloud AI Provider (Google Gemma 4 via Google Gemini API)
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# AI Provider Selection: "ollama" (offline default) or "gemma"
SILAISATHI_AI_PROVIDER=ollama

# Local Ollama Settings (Loopback only)
SILAISATHI_OLLAMA_HOST=http://127.0.0.1:11434
SILAISATHI_MODEL=qwen3.5:4b

# Optional Gemma Model
SILAISATHI_GEMMA_MODEL=gemma-4-26b-a4b-it

# Demo Mode & Deployment Flags
SILAISATHI_DEMO_MODE=1
SILAISATHI_CLOUD_DEPLOYMENT=0
